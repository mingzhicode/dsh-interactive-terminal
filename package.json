{
  "name": "dsh-interactive-terminal",
  "version": "0.1.0",
  "description": "Interactive terminal plugin for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/client.js",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-brand": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8",
    "react": "^18.3.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "6.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh": "0.1.0-rc.8",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-modules": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.8",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.8",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm-replay": "0.1.0-rc.8",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.8",
    "@deepseek-ai/dsh-sandbox-local": "0.1.0-rc.8",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.0-rc.8",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.8",
    "@deepseek-ai/dsh-subprocess-local": "0.1.0-rc.8",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "^22.20.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/ws": "^8.18.1",
    "@xterm/xterm": "6.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "playwright": "1.63.0",
    "publint": "0.3.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "build": "tsdown && tsc --project tsconfig.client.build.json && node scripts/build-client.mjs",
    "test": "vitest run --exclude tests/artifact.spec.ts --exclude tests/npm-pack.spec.ts",
    "test:artifacts": "vitest run tests/artifact.spec.ts",
    "test:package": "vitest run tests/npm-pack.spec.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.client.json --noEmit",
    "typecheck:artifacts": "tsc --project tests/types/tsconfig.host.json && tsc --project tests/types/tsconfig.client.json && tsc --project tests/types/tsconfig.web.json && tsc --project tests/types/tsconfig.package.json",
    "verify": "pnpm run typecheck && pnpm run build && pnpm run typecheck:artifacts && pnpm run test && pnpm run test:artifacts && pnpm run test:package"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
